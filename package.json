    "build": "node scripts/verify-chromium.js && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/init-db.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:complete-reset": "tsx scripts/complete-reset.ts",
    "db:create": "tsx scripts/create-db.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release": "commit-and-tag-version"
  },
